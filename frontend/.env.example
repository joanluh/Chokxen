# Formulario de acceso conectado al backend.
VITE_DATA_MODE=api
# Mantiene Básico, Premium y Administrador como experiencias de prueba.
VITE_ENABLE_DEMO=true
VITE_API_URL=/api/v1
# Destino del proxy de desarrollo, accesible con Tailscale conectado.
BACKEND_URL=http://127.0.0.1:8080
# ESPN y encuentros de ejemplo identificados en las experiencias demo.
VITE_SPORTS_MODE=espn
