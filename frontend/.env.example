# Compose del frontend: dirección accesible DESDE el contenedor de Nginx.
# Backend en otro contenedor de esta misma computadora, publicado en 8080:
BACKEND_URL=http://host.docker.internal:8080
# Backend de Daniel por Tailscale: sustituye el valor anterior por
# BACKEND_URL=http://100.75.117.118:8080
# Usa solo origen y puerto; sin /api/v1 ni barra al final.
FRONTEND_PORT=5173

# Compilación: tres perfiles de prueba, independientes del backend.
VITE_ENABLE_DEMO=true

# Configuración de React. Docker fija estas tres variables en el Dockerfile.
VITE_DATA_MODE=api
VITE_API_URL=/api/v1
VITE_SPORTS_MODE=espn
